# Copy to .env and fill in your values. Do not commit .env to git.

DATABASE_URL="sqlserver://HOST:1433;database=DB_NAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"
SHADOW_DATABASE_URL="sqlserver://HOST:1433;database=DB_NAME_shadow;user=USER;password=PASSWORD;trustServerCertificate=true"

# Required only when manually running prisma/seed.ts (never run automatically)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# Optional: public QR origin; default remains https://mygreenhouses.ir
# NEXT_PUBLIC_SITE_URL=https://mygreenhouses.ir
