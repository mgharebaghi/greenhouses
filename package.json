{
  "name": "green-house-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint app features server shared tests scripts prisma next.config.ts --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "test:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write app features server shared tests docs scripts package.json next.config.ts eslint.config.mjs --ignore-path .gitignore",
    "format:check": "prettier --check app features server shared tests docs scripts package.json next.config.ts eslint.config.mjs --ignore-path .gitignore",
    "check": "npm run lint && npm run typecheck && npm test",
    "postbuild": "node scripts/prepare-standalone.mjs && node scripts/check-build-output.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "antd": "^5.27.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "export-to-csv": "^1.4.0",
    "jalaliday": "^3.1.1",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-multi-date-picker": "^4.5.2",
    "react-to-print": "^3.2.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prettier": "^3.9.10",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
